{
  "name": "dsh-crt-theme",
  "version": "1.0.0",
  "type": "module",
  "description": "CRT terminal skin for DeepSeek Harness: black-green phosphor palette, scanlines, mono type.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinglhy2006/dsh-crt-theme.git"
  },
  "homepage": "https://github.com/kinglhy2006/dsh-crt-theme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
